# Cruxfile for looprs
pipeline: looprs-ci

steps:
  - step: self-check
    handler: shell::capture
    args:
      cmd: "taskit self check"
  - step: fmt-check
    handler: shell::capture
    args:
      cmd: "taskit check fmt --check"
  - step: lint
    handler: shell::capture
    args:
      cmd: "taskit check lint"
  - step: compile-tests
    handler: shell::capture
    args:
      cmd: "taskit check compile"
  - step: test
    handler: shell::capture
    args:
      cmd: "taskit test run"
  - step: check-deps
    handler: shell::capture
    args:
      cmd: "taskit check deps"
  - step: check-protocol-drift
    handler: shell::capture
    args:
      cmd: "taskit protocol drift"
